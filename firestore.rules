rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Models
    function isValidProfile(data) {
      return data.keys().hasAll(['userId', 'profession', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.profession is string && data.profession.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidProfileUpdate(data) {
      return data.userId == existing().userId &&
             data.userId == request.auth.uid &&
             data.updatedAt == request.time;
    }

    function isValidResult(data) {
      return data.keys().hasAll(['userId']) &&
             data.userId == request.auth.uid;
    }

    // Collections
    
    // Profiles
    match /profiles/{userId} {
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow read: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow delete: if false; 
    }

    // Results
    match /results/{userId} {
      allow create, update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow read: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow delete: if false;
    }

    // Metrics (Global)
    match /metrics/{docId} {
      // For MVP, anyone can increment metrics. It's a risk but we constrain the keys.
      allow read: if true;
      allow update: if docId == 'global' && incoming().diff(existing()).affectedKeys().hasAny(['profilesCreated', 'cvsDownloaded', 'jobsViewed']);
      allow create: if docId == 'global';
    }
  }
}
